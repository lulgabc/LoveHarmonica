---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHead from "../components/SectionHead.astro";
import { PHASES, ROUTINES, REPERTOIRE } from "../data/roadmap";
import { url } from "../lib/url";
---

<BaseLayout
  title="12 个月路线图"
  description="从第一口呼吸到上台：48 周蓝调口琴学习路线，含每周练习重点、输出任务、阶段检查点和可勾选进度。"
  current="/roadmap"
>
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb"><a href={url("/")}>首页</a><span>/</span><span>学习路线</span></div>
      <span class="eyebrow" style="margin-top:18px;">The 12-month roadmap · 48 weeks</span>
      <h1>12 个月，<br />把蓝调吹进身体。</h1>
      <p class="lead">
        这不是一份“每天练 3 小时”的计划，而是一条可以跟、可以停、可以回来的路径。
        四个阶段，48 周，每周一个重点、一个练习、一个输出。勾选你的进度，下一次打开还在。
      </p>
      <div class="chapter-meta">
        <span class="pill pill-accent">零基础起点</span>
        <span class="pill">每周 3–5 次</span>
        <span class="pill">20–45 分钟/次</span>
        <span class="pill">进度保存在本地</span>
      </div>
    </div>
  </section>

  <section class="section section-tight">
    <div class="container">
      <div class="roadmap-progress" aria-label="路线图进度">
        <span class="progress-label">总进度 <strong data-progress-pct>0%</strong></span>
        <div class="progress-track"><div class="progress-fill" data-progress-fill></div></div>
        <span class="progress-label" data-progress-text>0 / 20 项完成</span>
        <button class="progress-reset" type="button" data-progress-reset>清空</button>
      </div>

      <h2 class="sr-only">路线图使用说明</h2>
      <div class="grid grid-3" style="margin-bottom:40px;">
        <article class="card reveal">
          <span class="card-index">01</span>
          <h3>先做，再完美</h3>
          <p>每周的“输出”比“练习时长”重要。哪怕只录 30 秒，也比“今天没准备好”强。</p>
        </article>
        <article class="card reveal">
          <span class="card-index">02</span>
          <h3>卡住就退一级</h3>
          <p>如果某周的内容吹不动，回到上一周，把基础再稳一次。路线图是地图，不是考试。</p>
        </article>
        <article class="card reveal">
          <span class="card-index">03</span>
          <h3>每周至少 jam 一次</h3>
          <p>打开伴奏机，把本周学的东西放进 12 小节。不能 jam 的知识，只是信息。</p>
        </article>
      </div>

      {PHASES.map((phase) => (
        <section class="phase-block" id={phase.id}>
          <div class="phase-head">
            <div class="phase-big-num">{phase.number}</div>
            <div>
              <span class="kicker">{phase.months} · {phase.weekRange}</span>
              <h2>{phase.title}</h2>
              <p>{phase.description}</p>
              <div class="phase-stats">
                <span class="pill pill-accent">阶段 {phase.number}</span>
                <span class="pill">{phase.weekRange}</span>
                <span class="pill">完成 <strong data-phase-count={phase.id}>0/0</strong></span>
              </div>
            </div>
          </div>

          <div class="phase-goals">
            {phase.goals.map((goal) => (
              <div class="phase-goal">
                <span>{goal.label}</span>
                <strong>{goal.text}</strong>
              </div>
            ))}
          </div>

          <div class="table-wrap" style="margin-bottom:22px;">
            <table class="week-table">
              <thead>
                <tr><th>周</th><th>重点</th><th>怎么练</th><th>本周输出</th></tr>
              </thead>
              <tbody>
                {phase.weeks.map((week) => (
                  <tr>
                    <td>W{week.week}</td>
                    <td>{week.focus}</td>
                    <td>{week.practice}</td>
                    <td>{week.output}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="grid grid-2" style="align-items:start;">
            <div>
              <span class="kicker" style="margin-bottom:12px;">Checkpoints</span>
              <ul class="checklist">
                {phase.checkpoints.map((check) => (
                  <li class="check-item">
                    <input type="checkbox" id={check.id} data-check={check.id} />
                    <label for={check.id}>
                      {check.text}
                      <span class="check-note">{check.note}</span>
                    </label>
                  </li>
                ))}
              </ul>
            </div>
            <div class="card" style="padding:20px;">
              <span class="kicker">Listen &amp; study</span>
              <h3 style="font-size:1.1rem;margin:10px 0 8px;">这一阶段听什么</h3>
              <ul class="resource-links" style="margin-bottom:16px;">
                {phase.listening.map((item) => <li>{item}</li>)}
              </ul>
              <h3 style="font-size:1.1rem;margin:10px 0 8px;">配套课程</h3>
              <ul class="resource-links">
                {phase.courses.map((item) => <li>{item}</li>)}
              </ul>
              <a class="text-link" href={url("/courses/")} style="margin-top:14px;">打开课程库 →</a>
            </div>
          </div>
        </section>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Starter repertoire"
        title="第一年，先拿下这 10 首"
        description="不要一开始就挑战完整 solo。先学 head、再学一个 chorus，最后把整首放进你的 setlist。"
      />
      <div class="table-wrap">
        <table>
          <thead><tr><th>曲目</th><th>演奏者</th><th>阶段</th><th>练什么</th><th>为什么</th></tr></thead>
          <tbody>
            {REPERTOIRE.map((item) => (
              <tr>
                <td><strong>{item.title}</strong></td>
                <td>{item.artist}</td>
                <td style="white-space:nowrap;">{item.phase}</td>
                <td>{item.focus}</td>
                <td>{item.why}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="small muted" style="margin-top:12px;">
        提示：不同录音的调性/口琴调可能不同。先用耳朵找到原曲的调，再按第二把位表选琴；不要只看网上 tab 的调。
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Daily routines"
        title="每天练什么？三种时长"
        description="不用每天 90 分钟。20 分钟能维持，45 分钟能进步，90 分钟适合周末深度练习。选一个能坚持的。"
        link="/toolkit/#timer"
        linkLabel="打开练习计时器"
      />
      <div class="routine-grid">
        {ROUTINES.map((routine) => (
          <article class="card routine-card reveal">
            <h3>{routine.name}</h3>
            <div class="routine-total">{routine.total} min</div>
            <ul class="routine-list">
              {routine.blocks.map((block) => (
                <li><span>{block.name}</span><span>{block.minutes} min</span></li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Rules of the road"
        title="六条比练习时长更重要的规则"
        description="这些规则会决定你能不能坚持 12 个月，而不是决定你第 3 个月能吹多快。"
      />
      <div class="grid grid-2">
        <article class="card reveal">
          <h3>1. 每天碰琴，比每周猛练重要</h3>
          <p>10 分钟长音 + 5 分钟曲子，比周末 3 小时更能建立肌肉记忆。口琴是“少量多次”的乐器。</p>
        </article>
        <article class="card reveal">
          <h3>2. 录音，但不要审判自己</h3>
          <p>录音是为了发现问题，不是为了证明你不行。每次只挑一个点改进，不要一次否定全部。</p>
        </article>
        <article class="card reveal">
          <h3>3. 先学“怎么练”，再学“练什么”</h3>
          <p>慢速、分段、循环、跟唱、录音——这些方法比多买一本书更重要。</p>
        </article>
        <article class="card reveal">
          <h3>4. 找一个可以一起玩的人</h3>
          <p>吉他手、歌手、另一个口琴手都行。哪怕一个月一次，jam 会让学习有方向。</p>
        </article>
        <article class="card reveal">
          <h3>5. 保护耳朵和身体</h3>
          <p>电声不要长时间大音量；压音不要用喉咙硬挤；手累就休息。口琴是一辈子的乐器，不差这一周。</p>
        </article>
        <article class="card reveal">
          <h3>6. 允许自己“退步”</h3>
          <p>有些周就是吹不好。睡眠、压力、天气都会影响口琴。第二天再试，不要把它当成“没有天赋”。</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
