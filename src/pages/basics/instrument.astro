import ChapterLayout from "../../components/ChapterLayout.astro";
import { url } from "../../lib/url";

const toc = [
  { id: "types", label: "三种口琴" },
  { id: "anatomy", label: "十孔口琴的构造" },
  { id: "layout", label: "C 调琴的音位" },
  { id: "first-harp", label: "第一把琴怎么选" },
  { id: "models", label: "品牌与型号" },
  { id: "care", label: "保养与寿命" },
  { id: "faq", label: "常见问题" },
