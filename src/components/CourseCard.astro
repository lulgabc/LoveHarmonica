---
import type { Course } from "../data/courses";

interface Props {
  course: Course;
}

const { course } = Astro.props;

const icons: Record<string, string> = {
  "免费课程": "M8 5.5v13l11-6.5-11-6.5Z",
  "免费试听": "M8 5.5v13l11-6.5-11-6.5Z",
  "付费课程": "M4 6h16v12H4zM8 6v12",
  "曲谱工具": "M5 4h14v16H5zM8 8h8M8 12h8M8 16h5",
  "参考网站": "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18ZM3 12h18M12 3c2.4 2.5 3.6 5.6 3.6 9S14.4 18.5 12 21",
  "播客社区": "M12 4a3 3 0 0 0-3 3v5a3 3 0 0 0 6 0V7a3 3 0 0 0-3-3ZM5 11a7 7 0 0 0 14 0M12 18v3",
};
const icon = icons[course.type] || icons["免费课程"];
---

<article
  class="course-card reveal"
  data-filter-item
  data-price={course.price}
  data-level={course.level}
  data-lang={course.lang}
  data-type={course.type}
>
  <div class="course-top">
    <span class="course-type">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d={icon} stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      {course.type}
    </span>
    <span class:list={["pill", course.price === "免费" ? "pill-teal" : course.price === "免费试听" ? "pill-accent" : "pill-oxblood"]}>{course.price}</span>
  </div>
  <h3><a href={course.url} target="_blank" rel="noopener noreferrer">{course.title}</a></h3>
  <div class="course-provider">{course.provider} · {course.teacher}</div>
  <p>{course.description}</p>
  <div class="course-meta">
    <span class="pill">{course.level}</span>
    <span class="pill">{course.lang}</span>
    {course.tags.slice(0, 2).map((tag) => <span class="pill">{tag}</span>)}
  </div>
  <a class="course-link" href={course.url} target="_blank" rel="noopener noreferrer">打开课程 / 频道 <span aria-hidden="true">↗</span></a>
</article>
