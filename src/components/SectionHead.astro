---
import { url } from "../lib/url";

interface Props {
  kicker?: string;
  title: string;
  description?: string;
  link?: string;
  linkLabel?: string;
  align?: "left" | "center";
}

const { kicker, title, description, link, linkLabel, align = "left" } = Astro.props;
---

<div class:list={["section-head", align === "center" && "section-head-center"]}>
  <div class="section-title">
    {kicker && <span class="kicker">{kicker}</span>}
    <h2>{title}</h2>
  </div>
  <div class="section-aside">
    {description && <p>{description}</p>}
    {link && linkLabel && (
      <a class="text-link" href={url(link)}>
        {linkLabel} <span aria-hidden="true">→</span>
      </a>
    )}
  </div>
</div>
