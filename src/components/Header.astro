---
import { SITE } from "../lib/site";
import { stripBase, url } from "../lib/url";

interface Props {
  current?: string;
}

const path = stripBase(Astro.url.pathname);

function isActive(href: string) {
  if (href === "/") return path === "/";
  const clean = href.replace(/\/$/, "");
  return path === clean || path.startsWith(`${clean}/`);
}

const navItems = SITE.nav.map((item) => ({
  ...item,
  active: isActive(item.href),
}));
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={url("/")}>
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 44 44" fill="none">
          <circle cx="22" cy="22" r="20" stroke="currentColor" stroke-width="1" opacity=".45" />
          <path d="M10 17.5h24v9H10z" stroke="currentColor" stroke-width="1.1" opacity=".72" />
          <path d="M14 17.5v9M18 17.5v9M22 17.5v9M26 17.5v9M30 17.5v9" stroke="currentColor" stroke-width=".8" opacity=".55" />
          <circle cx="22" cy="22" r="2.2" fill="currentColor" />
          <path d="M6.5 22c1.6-3.1 3.2-3.1 4.8 0s3.2 3.1 4.8 0M27.9 22c1.6-3.1 3.2-3.1 4.8 0s3.2 3.1 4.8 0" stroke="currentColor" stroke-width=".8" opacity=".5" />
        </svg>
      </span>
      <span class="brand-text">
        <span class="brand-name">LoveHarmonica</span>
        <span class="brand-sub">Blues Harp Field Guide</span>
      </span>
    </a>

    <nav class="main-nav" aria-label="主要导航">
      {navItems.map((item) => (
        <a href={url(item.href)} aria-current={item.active ? "page" : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-tools">
      <a class="header-start" href={url("/roadmap/#phase-1")}>
        <span class="header-start-dot" aria-hidden="true"></span>
        开始 30 天
      </a>
      <button class="icon-btn" id="theme-toggle" type="button" aria-label="切换主题" title="切换明暗主题">
        <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" stroke-linecap="round" />
        </svg>
        <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.5 8.5 0 1 0 20.5 14.2Z" stroke-linejoin="round" />
        </svg>
      </button>
      <button class="icon-btn mobile-toggle" id="mobile-toggle" type="button" aria-label="打开菜单" aria-controls="mobile-nav" aria-expanded="false">
        <svg class="menu-open-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
        <svg class="menu-close-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>
</header>

<nav class="mobile-nav" id="mobile-nav" aria-label="移动端导航">
  {navItems.map((item) => (
    <a href={url(item.href)} aria-current={item.active ? "page" : undefined}>
      <span>{item.label}</span>
      <span aria-hidden="true">→</span>
    </a>
  ))}
  <div class="mobile-nav-foot">
    <span>C harp · 2nd position</span>
    <span>Breathe the blues.</span>
  </div>
</nav>
